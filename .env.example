# 复制为 .env.local 后再填。不要把填好的文件提交进仓库。
# 只排盘可以留空：没有密钥时，命盘照常显示，解读按钮会说明接口未配置。

# ─── xAI（Grok），OpenAI 兼容 Chat Completions ───
# 文档：https://docs.x.ai/developers/models
# 当前面向对话的通用模型是 grok-4.7（Models 页 Chat 一行）。
# 请求发到 https://api.x.ai/v1/chat/completions ，Authorization: Bearer <密钥>。
AI_PROVIDER=xai

# 二选一。XAI_API_KEY 优先；AI_API_KEY 是同一个密钥的别名。
XAI_API_KEY=
# AI_API_KEY=

# 一般不用改。根地址不要带 /chat/completions。
# XAI_BASE_URL=https://api.x.ai/v1
# AI_BASE_URL=https://api.x.ai/v1

# 想换模型时再改。AI_MODEL 会盖过 XAI_MODEL。
# XAI_MODEL=grok-4.7
# AI_MODEL=grok-4.7

# ─── 换别的 OpenAI 兼容服务时才需要 ───
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
#
# AI_PROVIDER=compatible
# AI_API_KEY=
# AI_BASE_URL=https://your-provider.example/v1
# AI_MODEL=your-model

# ─── 站点 ───
# 本地开发用 localhost。在线演示是 GitHub Pages：
# https://dannywang0822.github.io/ziwei-doushu
# 源码：https://github.com/Dannywang0822/ziwei-doushu
NEXT_PUBLIC_SITE_URL=http://localhost:3000
